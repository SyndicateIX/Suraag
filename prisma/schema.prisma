generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Case {
  id             String               @id @default(uuid())
  caseNumber     String               @unique
  title          String
  status         String               @default("ACTIVE") // ACTIVE, CRITICAL, ARCHIVED, PENDING_AUDIT
  priority       String               @default("HIGH")   // CRITICAL, HIGH, ROUTINE
  assignedTo     String
  location       String
  incidentDate   DateTime
  summary        String
  confidenceScore Float               @default(94.2)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  evidence       Evidence[]
  witnesses      WitnessStatement[]
  suspects       Suspect[]
  timelineEvents TimelineEvent[]
  reconstruction ReconstructionData?
  cdrDatasets    CDRDataset[]
  canonicalIdentities CanonicalIdentity[]
  extractedEntities   ExtractedEntity[]
}

model CDRDataset {
  id           String      @id @default(uuid())
  caseId       String
  case         Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName     String
  operatorName String      @default("AUTO") // Airtel, Jio, Vi, BSNL, AT&T, Vodafone
  recordCount  Int         @default(0)
  targetNumber String?
  uploadDate   DateTime    @default(now())
  records      CDRRecord[]
  createdAt    DateTime    @default(now())
}

model CDRRecord {
  id              String      @id @default(uuid())
  datasetId       String
  dataset         CDRDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  callingNumber   String
  calledNumber    String
  imeiCalling     String?
  imeiCalled      String?
  timestamp       DateTime
  durationSeconds Int         @default(0)
  callType        String      @default("VOICE") // VOICE, SMS, DATA, ROAMING, MISSED
  cellTowerId     String?
  lac             String?
  latitude        Float?
  longitude       Float?
  azimuth         Int?
  firstLocation   String?
  lastLocation    String?
  createdAt       DateTime    @default(now())
}

model CellTower {
  id           String   @id @default(uuid())
  towerId      String   @unique
  operator     String?
  locationName String
  latitude     Float
  longitude    Float
  azimuth      Int?
  rangeMeters  Float?   @default(1500)
  createdAt    DateTime @default(now())
}

model SuspectPhoneMapping {
  id          String   @id @default(uuid())
  caseId      String
  suspectId   String?
  phoneNumber String
  imei        String?
  ownerName   String?
  role        String?  // TARGET, SUSPECT, ASSOCIATE, VICTIM, WITNESS, BURNER
  notes       String?
  createdAt   DateTime @default(now())
}

model Evidence {
  id             String    @id @default(uuid())
  caseId         String
  case           Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title          String
  category       String    // WEAPON, BLOOD, FOOTPRINT, VEHICLE, PHONE, FINGERPRINT, BALLISTICS, CCTV, DOCUMENT
  fileUrl        String
  fileType       String
  confidence     Float
  boundingBoxes  Json?     // [{ x: number, y: number, width: number, height: number, label: string, confidence: number }]
  processedStatus String   @default("COMPLETED") // PENDING, PROCESSING, COMPLETED
  metadata       Json?
  createdAt      DateTime  @default(now())
}

model WitnessStatement {
  id             String    @id @default(uuid())
  caseId         String
  case           Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  witnessName    String
  role           String    @default("Primary Witness")
  statementDate  DateTime
  statementText  String
  aiExtraction   Json?     // { entities: string[], locationClaims: string[], timelineClaims: string[] }
  credibilityScore Float   @default(85.0)
  contradictions Json?     // [{ target: string, reason: string, severity: string }]
  createdAt      DateTime  @default(now())
}

model Suspect {
  id             String    @id @default(uuid())
  caseId         String
  case           Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name           String
  alias          String?
  riskScore      Int       @default(80) // 0 - 100
  probability    Float     @default(0.75)
  criminalHistory Json?    // string[]
  phone          String?
  gpsCoordinates Json?     // [{ time: string, lat: number, lng: number }]
  linkedEvidenceIds Json?  // string[]
  aiReasoning    String?
  createdAt      DateTime  @default(now())
}

model TimelineEvent {
  id                   String   @id @default(uuid())
  caseId               String
  case                 Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  timestamp            String
  title                String
  description          String
  category             String   // AUDIO, CCTV, BALLISTICS, WITNESS, VEHICLE, NETWORK
  confidence           Float    @default(90.0)
  aiReasoning          String?
  supportingEvidenceIds Json?   // string[]
  createdAt            DateTime @default(now())
}

model ReconstructionData {
  id               String   @id @default(uuid())
  caseId           String   @unique
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  attackerPosition Json     // { x: number, y: number, z: number }
  victimPosition   Json     // { x: number, y: number, z: number }
  attackDirection  String
  weaponAngle      String
  lineOfSight      Json     // { visibilityScore: number, occludedBy: string[] }
  physicsResults   Json     // { bulletTrajectory: any, bloodSpatter: any }
  scenarios        Json     // [{ id: string, name: string, probability: number, description: string, evidenceCount: number }]
  createdAt        DateTime @default(now())
}

model User {
  id             String   @id @default(uuid())
  employeeId     String   @unique
  email          String   @unique
  password       String
  name           String
  role           String   @default("Investigator")
  department     String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CanonicalIdentity {
  id             String         @id @default(uuid())
  caseId         String
  case           Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  primaryName    String
  type           String         @default("SUSPECT") // SUSPECT, WITNESS, VICTIM, ASSOCIATE
  riskScore      Float          @default(50.0)
  notes          String?
  penalCharges   Json?          // Array of legal codes e.g. ["IPC-302", "BNS-103"]
  metadata       Json?
  aliasMappings  AliasMapping[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ExtractedEntity {
  id              String         @id @default(uuid())
  documentId      String
  caseId          String?
  case            Case?          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  entityType      String         // PERSON, ALIAS, PENAL_CODE, LOCATION, VEHICLE, WEAPON, TIMESTAMP, ORGANIZATION, PHONE
  textValue       String
  startIndex      Int
  endIndex        Int
  confidenceScore Float          @default(0.9)
  contextSnippet  String?
  metadata        Json?          // { penalCodeDetails?: any, coOccurrence?: any, documentTitle?: string, attemptPhase?: string }
  aliasMappings   AliasMapping[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model AliasMapping {
  id                  String            @id @default(uuid())
  extractedEntityId   String
  extractedEntity     ExtractedEntity   @relation(fields: [extractedEntityId], references: [id], onDelete: Cascade)
  canonicalIdentityId String
  canonicalIdentity   CanonicalIdentity @relation(fields: [canonicalIdentityId], references: [id], onDelete: Cascade)
  resolutionMethod    String            @default("AUTOMATIC_FUZZY") // AUTOMATIC_FUZZY, AUTOMATIC_LLM, MANUAL_OVERRIDE
  confidence          Float             @default(0.85)
  isApproved          Boolean           @default(false)
  reasoning           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model LegalPenalCode {
  id             String   @id @default(uuid())
  code           String   @unique // e.g. "IPC-302", "BNS-103"
  sectionNumber  String   // e.g. "302", "103"
  statute        String   // "IPC" or "BNS"
  title          String
  category       String   // "HOMICIDE", "CONSPIRACY", "ASSAULT", "EVIDENCE_TAMPERING", "FRAUD", etc.
  severityLevel  String   // "CRITICAL", "HIGH", "MEDIUM", "ROUTINE"
  description    String
  punishment     String?
  bnsEquivalent  String?
  ipcEquivalent  String?
  keyElements    Json?    // string[]
  createdAt      DateTime @default(now())
}

